# Django
SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco
DATABASE_URL=postgres://t4e:t4e@db:5432/t4e_office

# Redis (uso adiado — Presença/Poker/Celery)
REDIS_URL=redis://redis:6379/0

# CORS (frontend Vite)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# JWT
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# Email (Gmail SMTP — grátis ~500/dia)
# Dev: EMAIL_BACKEND=console em settings/dev.py → não precisa preencher
# Prod: gerar App Password em myaccount.google.com/apppasswords (2FA obrigatório)
EMAIL_HOST_USER=seuemail@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_EMAIL=T4E Office <seuemail@gmail.com>
FRONTEND_URL=http://localhost:8080

# Copiloto IA — as chaves de API agora são por workspace (cifradas no banco).
# Estes valores abaixo são apenas fallback/defaults globais e são opcionais.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o
# Chave Fernet p/ cifrar as chaves de IA por workspace. Se vazia, reaproveita
# GOOGLE_TOKEN_ENC_KEY. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CONFIG_ENC_KEY=

# Integração Google (OAuth + Calendar) — credenciais em console.cloud.google.com
# OAuth consent screen + Credentials (OAuth client ID, tipo "Web application").
# Redirect URI autorizado deve bater com GOOGLE_OAUTH_REDIRECT_URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/callback/
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENC_KEY=

# Integração GitHub (OAuth App: https://github.com/settings/developers)
# Authorization callback URL deve bater com GITHUB_OAUTH_REDIRECT_URI.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/github/oauth/callback/
# URL pública p/ o webhook (use ngrok/cloudflared em dev). Vazio = sem eventos.
GITHUB_WEBHOOK_CALLBACK_URL=
# Fernet p/ cifrar o token; se vazio, reaproveita GOOGLE_TOKEN_ENC_KEY.
GITHUB_TOKEN_ENC_KEY=
